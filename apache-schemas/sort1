#!/bin/bash

declare -r SCRIPT=${0##*/}

# ${1} - array indexed with integers
# ${2} - label (optional)
function print_int_array
{
  local -r label=${2:-${1}}
  local -n array=${1}
  local -i i=0
  echo "${label} size = [${#array[@]}]"
  for ((i = 0; i < ${#array[@]}; i++))
  do
    echo "${label}[${i}] = [${array[${i}]}]" | sed 's/=/;/g'
  done | column -s"=" -o"=" -t | sed 's/;/=/g'
}

# ${1} - xsd file
# ${2} - file type
function sort_schema_attributes
{
  local -r file_type="${2}"
  local -a attributes
  mapfile -t attributes < <(grep '^<xs:schema .*>$' "${1}" | sed 's/>$//;s/   */ /g;s/ /\n/g')
##  print_int_array attributes
  local schema_line
  local xmlns
  local -i i=1
  for ((i = 1; i < ${#attributes[@]}; i++))
  do
    if [[ "${attributes[${i}]}" =~ ^xmlns ]]
    then
      xmlns+=" ${attributes[${i}]}"
    else
      schema_line+=" ${attributes[${i}]}"
    fi
  done
  xmlns=$(echo "${xmlns}" | tr ' ' '\n' | sort | paste -sd' ')
  schema_line=$(echo "${schema_line}" | tr ' ' '\n' | sort | paste -sd' ')
  schema_line="${attributes[0]} ${xmlns# } ${schema_line# }>"
  sed -i "s|^<xs:schema .*>$|${schema_line}|" "${1}"
  local -i stat=${?}
  if [[ 0 -ne ${stat} ]]
  then
    echo "[${SCRIPT}] ERROR: Failed to sort attributes for [xs:schema] in [${file_type}] file [${1}] due to error code [${stat}]."
  fi
  return "${stat}"
}

while [[ -n "${1}" ]]
do
  sort_schema_attributes "${1}"
  shift 1
done

