#!/usr/bin/gawk -f

BEGIN {
  xs_doc_indent="";
  in_xs_doc=0;
}
{
  if (0 != match($0, /(^\s*)(<xs:documentation .+=".+">$)/, matches))
  {
    xs_doc_indent=matches[1];
    in_xs_doc=1;
    printf("%s\n", $0);
  }
  else if (0 != match($0, /(^\s*)(<xs:documentation>$)/, matches))
  {
    xs_doc_indent=matches[1];
    in_xs_doc=1;
    printf("%s\n", $0);
  }
  else if (0 != match($0, /(^\s*)(<xs:documentation .+=".+">)(.+[^>]$)/, matches))
  {
    xs_doc_indent=matches[1];
    in_xs_doc=1;
    printf("%s%s\n%s  %s\n", xs_doc_indent, matches[2], xs_doc_indent, matches[3]);
  }
  else if (0 != match($0, /(^\s*)(<\/xs:documentation>$)/, matches))
  {
    printf("%s%s\n", xs_doc_indent, matches[2]);
    xs_doc_indent="";
    in_xs_doc=0;
  }
  else if (0 != match($0, /(^\s+)([^ <].*)(<\/xs:documentation>$)/, matches))
  {
    printf("%s  %s\n%s%s", xs_doc_indent, matches[2], xs_doc_indent, matches[3]);
    xs_doc_indent="";
    in_xs_doc=0;
  }
  else if ((1 == in_xs_doc) && (0 != length($0)))
  {
    match($0, /(^\s+)(.*)/, matches);
    if (length(matches[1]) < length(xs_doc_indent))
    {
      printf("%s%s\n", xs_doc_indent, matches[2]);
    }
    else
    {
      printf("%s\n", $0);
    }
  }
  else
  {
    printf("%s\n", $0);
  }
}
