#!/usr/bin/gawk -f

################################################################################
# Replaces blank lines, that are not within <xs:documentation ...>,            #
# </xs:documentation> with marker.                                             #
#   awk2 --include inplace ...                                                 #
################################################################################
BEGIN {
  marker="<!--xxxx-xxxx-xxxx-->";
  multi_line_marker="multi-line-comment-blank-line-marker";
}

# A multi-line comment block.
/^\s*<!--/,/-->\s*$/ {
    if (/^\s*$/) {
        print multi_line_marker;
    } else {
        print;
    }
    next;
}

# A documentation block. Blank lines inside are preserved.
/^\s*<xs:documentation/,/<\/xs:documentation>/ {
    print;
    next;
}

# Handle blank lines outside of the above blocks.
/^\s*$/ {
    print marker;
    next;
}

# Print any other non-blank line.
{
    print;
}
