<?xml version="1.0" encoding="utf-8"?>
<toolchains xmlns="http://maven.apache.org/TOOLCHAINS/1.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/TOOLCHAINS/1.1.0 https://maven.apache.org/xsd/toolchains-1.1.0.xsd">

<!-- JDK 8 toolchain -->
  <toolchain>
    <type>jdk</type>
    <provides>
      <id>jdk-8-oracle</id>
      <version>1.8</version>
      <vendor>oracle</vendor>
    </provides>
    <configuration>
      <jdkHome>/usr/lib/jvm/java-8-oracle</jdkHome>
    </configuration>
  </toolchain>

<!-- JDK 17 toolchain -->
  <toolchain>
    <type>jdk</type>
    <provides>
      <id>jdk-17-adoptium</id>
      <version>17</version>
      <vendor>adoptium</vendor>
    </provides>
    <configuration>
      <jdkHome>/opt/jdk-17-adoptium</jdkHome>
    </configuration>
  </toolchain>

<!-- JDK 17 toolchain -->
  <toolchain>
    <type>jdk</type>
    <provides>
      <id>jdk-17-Linux</id>
      <version>17</version>
      <vendor>Oracle</vendor>
    </provides>
    <configuration>
      <jdkHome>/usr/lib/jvm/default-java</jdkHome>
    </configuration>
  </toolchain>

<!-- JDK 17 toolchain -->
  <toolchain>
    <type>jdk</type>
    <provides>
      <id>jdk-17-Windows</id>
      <version>17</version>
      <vendor>Oracle</vendor>
    </provides>
    <configuration>
      <jdkHome>C:\\Users\\user1\\jdk17</jdkHome>
    </configuration>
  </toolchain>

<!-- Custom toolchain for JavaCPP -->
  <toolchain>
    <type>javacpp</type>
    <provides>
      <id>javacpp-1.5</id>
      <version>1.5</version>
    </provides>
    <configuration>
      <javacppExecutable>/usr/local/bin/javacpp</javacppExecutable>
      <options>
        <option>-DcustomFlag=true</option>
      </options>
    </configuration>
  </toolchain>

</toolchains>

