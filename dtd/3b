#!/bin/bash

# shellcheck disable=all

rm -f qq_*pom.xml

PRE_COMMIT=~/.git_template/.git_hooks_dev/pre-commit

function xindent
{
  echo "===== BEGIN [${FUNCNAME[0]}] ====="
  export PRE_COMMIT_XML_BEAUTIFIER_COMMAND=xmlindent
  export PRE_COMMIT_XML_LINTER_COMMAND=xmllint
  export PRE_COMMIT_XML_VALIDATOR_COMMAND=xmllint
  export PRE_COMMIT_XML_XPATH_COMMAND=xmllint
  ./upom
  ${PRE_COMMIT} pom.xml
##  cp pom.xml qq_${PRE_COMMIT_XML_BEAUTIFIER_COMMAND}_pom.xml
  echo "=====  END  [${FUNCNAME[0]}] ====="
  echo ''
}

function xlint
