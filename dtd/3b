function xutils
{
  echo "===== BEGIN [${FUNCNAME[0]}] ====="
  ./upom
  ps1-wrapper ${HOME}/scripts/power-shell/utilities-xml.ps1 -XmlFile ${PWD}/pom.xml -FileType 'Maven POM'
##  cp pom.xml qq_utilities_pom.xml
  echo "=====  END  [${FUNCNAME[0]}] ====="
  echo ''
}

