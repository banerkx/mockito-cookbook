      </plugin>
<!--Modifications for jacoco from: -->
<!-- https://www.lambdatest.com/blog/reporting-code-coverage-using-maven-and-jacoco-plugin/ -->
<!--To generate jacoco output, use: mvn test -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
<!--NOTE: The surefire plugin looks for test classes named: *Test.java -->
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.12.4</version>
        <executions>
          <execution>
            <id>default-test</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.3</version>
        <executions>
<!--Ensure there is a "prepare-agent" execution goal. This will prevent the error: -->
<!--Skipping JaCoCo execution due to missing execution data file. -->
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
<!--The default value for <destFile> is: ${project.build.directory} -->
              <destFile>${jacoco.data.file}</destFile>
              <propertyName>${jacoco.propertyName}</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
<!-- The default value for <dataFile> is: ${project.build.directory} -->
              <dataFile>${jacoco.data.file}</dataFile>
<!-- The default value for <outputDirectory> is: ${project.reporting.outputDirectory} -->
<!-- jacoco saves its output in csv, html, and xml format. -->
<!-- jacoco will save its csv output to .../target/site/<outputDirectory>/jacoco.csv. -->
<!-- jacoco will save its html output to .../target/site/<outputDirectory>/index.html. -->
<!-- jacoco will save its xml output to .../target/site/<outputDirectory>/jacoco.xml. -->
              <outputDirectory>${jacoco.output.directory}</outputDirectory>
            </configuration>
          </execution>
          <execution>
<!-- See: https://www.eclemma.org/jacoco/trunk/doc/check-mojo.html -->
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFile>${jacoco.data.file}</dataFile>
<!-- If test coverage minimum percentages are not met, then no error will be reported. -->
              <haltOnFailure>false</haltOnFailure>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <excludes>
<!-- Excluding unit test classes. -->
                    <exclude>*Test</exclude>
                  </excludes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${minimum.jacoco.test.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>CLASS</element>
                  <excludes>
<!-- Excluding unit test classes. -->
                    <exclude>*Test</exclude>
                  </excludes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${minimum.jacoco.test.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
<!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-enforcer-plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>no-duplicate-declared-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-java</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
<!--                            <skip>true</skip> -->
              <rules>
                <requireJavaVersion>
                  <version>${required.java.version}</version>
                  <message>Invalid java version; the java version must be greater than or equal to
                    [${required.java.version}]
                  </message>
                  <display>true</display>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-maven</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <skip>true</skip>
              <rules>
                <requireMavenVersion>
                  <version>3.9.1</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
