<!-- NOTE: Do not use a literal file separator, i.e., '/' or '\', in any path value; -->
<!-- always use the maven variable ${file.separator}. Otherwise, maven will -->
<!-- not be able to consistently understand the path in a mixed Windows/Linux environment. -->
    <jacoco.data.file> ${project.build.directory}${file.separator}coverage-reports${file.separator}jacoco-ut.exec </jacoco.data.file>
    <jacoco.output.directory> ${project.reporting.outputDirectory}${file.separator}jacoco-ut </jacoco.output.directory>
