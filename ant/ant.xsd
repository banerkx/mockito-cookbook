<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:simpleType name="boolean">
    <xs:restriction base="xs:token">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
      <xs:enumeration value="on"/>
      <xs:enumeration value="off"/>
      <xs:enumeration value="yes"/>
      <xs:enumeration value="no"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="tasks" abstract="true"/>
  <xs:element name="types" abstract="true"/>
  <xs:element name="project">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="target"/>
        <xs:element ref="extension-point"/>
        <xs:element ref="tasks"/>
        <xs:element ref="types"/>
      </xs:choice>
      <xs:attribute name="name"/>
      <xs:attribute name="default"/>
      <xs:attribute name="basedir"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="target">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="tasks"/>
        <xs:element ref="types"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="name" use="required"/>
      <xs:attribute name="if"/>
      <xs:attribute name="unless"/>
      <xs:attribute name="depends"/>
      <xs:attribute name="extensionOf"/>
      <xs:attribute name="onMissingExtensionPoint"/>
      <xs:attribute name="description"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="extension-point">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="name" use="required"/>
      <xs:attribute name="if"/>
      <xs:attribute name="unless"/>
      <xs:attribute name="depends"/>
      <xs:attribute name="extensionOf"/>
      <xs:attribute name="onMissingExtensionPoint"/>
      <xs:attribute name="description"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="concatfilter" substitutionGroup="types">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="append"/>
      <xs:attribute name="prepend"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="globmapper" substitutionGroup="types">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="handledirsep" type="boolean"/>
      <xs:attribute name="casesensitive" type="boolean"/>
      <xs:attribute name="to"/>
      <xs:attribute name="from"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="propertyset" substitutionGroup="types">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="propertyref"/>
        <xs:element ref="propertyset"/>
        <xs:element ref="mapper"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="description"/>
      <xs:attribute name="negate" type="boolean"/>
      <xs:attribute name="dynamic" type="boolean"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="propertyref">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="name"/>
      <xs:attribute name="builtin">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="all"/>
            <xs:enumeration value="system"/>
            <xs:enumeration value="commandline"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="regex"/>
      <xs:attribute name="prefix"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="mapper" substitutionGroup="types">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="classpath"/>
        <xs:element ref="mapper"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="classpath"/>
      <xs:attribute name="classpathref" type="xs:IDREF"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="type">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="identity"/>
            <xs:enumeration value="flatten"/>
            <xs:enumeration value="glob"/>
            <xs:enumeration value="merge"/>
            <xs:enumeration value="regexp"/>
            <xs:enumeration value="package"/>
            <xs:enumeration value="unpackage"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="description"/>
      <xs:attribute name="classname"/>
      <xs:attribute name="to"/>
      <xs:attribute name="from"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="classpath">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="fileset"/>
        <xs:element ref="dirset"/>
        <xs:element ref="extdirs"/>
        <xs:element ref="filelist"/>
        <xs:element ref="existing"/>
        <xs:element ref="pathelement"/>
        <xs:element ref="path"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="location"/>
      <xs:attribute name="cache" type="boolean"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="description"/>
      <xs:attribute name="path"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="fileset" substitutionGroup="types">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="patternset"/>
        <xs:element ref="exclude"/>
        <xs:element ref="include"/>
        <xs:element ref="custom"/>
        <xs:element ref="symlink"/>
        <xs:element ref="posixpermissions"/>
        <xs:element ref="none"/>
        <xs:element ref="present"/>
        <xs:element ref="not"/>
        <xs:element ref="type"/>
        <xs:element ref="readable"/>
        <xs:element ref="writable"/>
        <xs:element ref="executable"/>
        <xs:element ref="modified"/>
        <xs:element ref="or"/>
        <xs:element ref="contains"/>
        <xs:element ref="depend"/>
        <xs:element ref="ownedby"/>
        <xs:element ref="posixgroup"/>
        <xs:element ref="different"/>
        <xs:element ref="size"/>
        <xs:element ref="majority"/>
        <xs:element ref="containsregexp"/>
        <xs:element ref="filename"/>
        <xs:element ref="selector"/>
        <xs:element ref="includesfile"/>
        <xs:element ref="date"/>
        <xs:element ref="excludesfile"/>
        <xs:element ref="and"/>
        <xs:element ref="depth"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="dir"/>
      <xs:attribute name="file"/>
      <xs:attribute name="defaultexcludes" type="boolean"/>
      <xs:attribute name="followsymlinks" type="boolean"/>
      <xs:attribute name="erroronmissingdir" type="boolean"/>
      <xs:attribute name="casesensitive" type="boolean"/>
      <xs:attribute name="description"/>
      <xs:attribute name="excludes"/>
      <xs:attribute name="includesfile"/>
      <xs:attribute name="excludesfile"/>
      <xs:attribute name="maxlevelsofsymlinks"/>
      <xs:attribute name="includes"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="patternset" substitutionGroup="types">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="include"/>
        <xs:element ref="patternset"/>
        <xs:element ref="exclude"/>
        <xs:element ref="excludesfile"/>
        <xs:element ref="invert"/>
        <xs:element ref="includesfile"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="includes"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="description"/>
      <xs:attribute name="excludesfile"/>
      <xs:attribute name="includesfile"/>
      <xs:attribute name="excludes"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="include" substitutionGroup="tasks">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="name"/>
      <xs:attribute name="unless"/>
      <xs:attribute name="if"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="exclude">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="name"/>
      <xs:attribute name="unless"/>
      <xs:attribute name="if"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="excludesfile">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="name"/>
      <xs:attribute name="unless"/>
      <xs:attribute name="if"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="invert">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="include"/>
        <xs:element ref="patternset"/>
        <xs:element ref="exclude"/>
        <xs:element ref="excludesfile"/>
        <xs:element ref="invert"/>
        <xs:element ref="includesfile"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="includes"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="description"/>
      <xs:attribute name="excludesfile"/>
      <xs:attribute name="includesfile"/>
      <xs:attribute name="excludes"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="includesfile">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="name"/>
      <xs:attribute name="unless"/>
      <xs:attribute name="if"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="custom">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="classpath"/>
        <xs:element ref="param"/>
      </xs:choice>
