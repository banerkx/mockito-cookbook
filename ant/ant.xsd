  </xs:element>
  <xs:element name="param">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="name"/>
      <xs:attribute name="type"/>
      <xs:attribute name="value"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="symlink" substitutionGroup="tasks">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="posixpermissions">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="followsymlinks" type="boolean"/>
      <xs:attribute name="permissions"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="none">
