      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="error"/>
      <xs:attribute name="targetdir"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="description"/>
      <xs:attribute name="present">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="srconly"/>
            <xs:enumeration value="both"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="not">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="symlink"/>
        <xs:element ref="custom"/>
        <xs:element ref="posixpermissions"/>
        <xs:element ref="none"/>
        <xs:element ref="present"/>
        <xs:element ref="not"/>
        <xs:element ref="type"/>
        <xs:element ref="readable"/>
        <xs:element ref="writable"/>
        <xs:element ref="executable"/>
        <xs:element ref="modified"/>
        <xs:element ref="or"/>
        <xs:element ref="contains"/>
        <xs:element ref="depend"/>
        <xs:element ref="ownedby"/>
        <xs:element ref="posixgroup"/>
        <xs:element ref="different"/>
        <xs:element ref="size"/>
        <xs:element ref="majority"/>
        <xs:element ref="containsregexp"/>
        <xs:element ref="filename"/>
        <xs:element ref="selector"/>
        <xs:element ref="date"/>
        <xs:element ref="and"/>
        <xs:element ref="depth"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="error"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="description"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="type">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="error"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="type">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="file"/>
