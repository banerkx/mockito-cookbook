          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="description"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="readable">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="writable">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="executable">
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="modified">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="classpath"/>
        <xs:element ref="param"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="cache">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="propertyfile"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="comparator">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="equal"/>
            <xs:enumeration value="rule"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="update" type="boolean"/>
      <xs:attribute name="algorithmclass"/>
      <xs:attribute name="algorithm">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="hashvalue"/>
            <xs:enumeration value="digest"/>
            <xs:enumeration value="checksum"/>
            <xs:enumeration value="lastmodified"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="error"/>
      <xs:attribute name="cacheclass"/>
      <xs:attribute name="delayupdate" type="boolean"/>
      <xs:attribute name="description"/>
      <xs:attribute name="comparatorclass"/>
      <xs:attribute name="modified"/>
      <xs:attribute name="selres" type="boolean"/>
      <xs:attribute name="seldirs" type="boolean"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="or">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="symlink"/>
        <xs:element ref="custom"/>
        <xs:element ref="posixpermissions"/>
        <xs:element ref="none"/>
        <xs:element ref="present"/>
        <xs:element ref="not"/>
        <xs:element ref="type"/>
        <xs:element ref="readable"/>
        <xs:element ref="writable"/>
        <xs:element ref="executable"/>
        <xs:element ref="modified"/>
        <xs:element ref="or"/>
        <xs:element ref="contains"/>
        <xs:element ref="depend"/>
        <xs:element ref="ownedby"/>
        <xs:element ref="posixgroup"/>
