    </xs:complexType>
  </xs:element>
  <xs:element name="depend" substitutionGroup="tasks">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="mapper"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:ID"/>
      <xs:attribute name="error"/>
      <xs:attribute name="targetdir"/>
      <xs:attribute name="refid" type="xs:IDREF"/>
      <xs:attribute name="description"/>
      <xs:attribute name="granularity"/>
    </xs:complexType>
  </xs:element>
