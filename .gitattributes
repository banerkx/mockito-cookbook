################################################################################
# Invocation: git-eol-attributes                                           #
################################################################################

################################################################################
# With the setting:                                                            #
#   * text=auto                                                                #
# git inspects content of each file to guess whether it is text or binary. If  #
# git decides a file is text, git normalizes line endings to lf (\n) when the  #
# file is stored in the repository, regardless of what line endings are in     #
# the working directory. When that file is checked out, git converts the line  #
# endings to match the native platform convention — crlf (\r\n) on Windows, lf #
# on Unix/Linux/macOS — if your core.autocrlf setting or platform defaults     #
# call for it. If core.autocrlf is false (or unset and you are on Unix),       #
# checkout keeps lf. Files git detects as binary (images, compiled binaries,   #
# etc.) are left untouched — no conversion happens.                            #
#                                                                              #
# To renormalize eol for all files in the current branch, use:                 #
#   git add --renormalize -A                                                   #
#                                                                              #
# This re-reads every tracked file through the current attribute rules and     #
# re-applies text/EOL normalization, staging any changes needed (only for      #
# files where normalization actually differs from what is stored).             #
################################################################################
* text=auto

################################################################################
# The following file extensions should be treated as text files.               #
################################################################################
*.dtd    text eol=lf
*.groovy text eol=lf
*.java   text eol=lf
*.json   text eol=lf
*.pom    text eol=lf
*.xml    text eol=lf
*.xsd    text eol=lf

################################################################################
# Need to ensure that a shebang line, e.g., #!/bin/bash, ends in:              #
#                                                                              #
#   #!/bin/bash[lf]                                                            #
#                                                                              #
# and not:                                                                     #
#                                                                              #
#   #!/bin/bash[crlf]                                                          #
#                                                                              #
# On Linux, if a shebang line ends in [crlf], then the specified interpreter   #
# will not be found. For example, if the shebang line is #!/bin/gawk, then     #
# the script will try to find /bin/gawk[cr] **and not** /bin/gawk. Note that   #
# a script with the shebang line #!/bin/bash[lf] will also work in git-bash.   #
#                                                                              #
# If a file has a shebang line, then git-bash treats that file as executable.  #
# Linux does not do the same thing; a file must specifically be given execute  #
# permission.                                                                  #
#                                                                              #
# To ensure that such files are executable on Linux, the execute permission    #
# must be added to the git index for such files.                               #
#                                                                              #
# To see if a file has executable permission in the git index, do the          #
# following:                                                                   #
#                                                                              #
#   git ls-files --stage [/path/to/my/script.sh] | cut -d" " -f1               #
#                                                                              #
# If the output from the previous command is "100644", then the execute        #
# permission is missing. The following command can be used to add the execute  #
# permission to the git index for the file:                                    #
#                                                                              #
#   git update-index --chmod=+x [/path/to/my/script.sh]                        #
#                                                                              #
# Now re-running the previous command to check the execute permission on the   #
# file will output "100755".                                                   #
#                                                                              #
# If an executable text file is being added to git for the first time, then    #
# the following "git add" command will add execute permission to the git index #
# for the file:                                                                #
#                                                                              #
#   git add --chmod=+x /path/to/executable/file/some_script.sh                 #
################################################################################

