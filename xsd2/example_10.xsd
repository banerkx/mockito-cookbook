<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:a="http://example.com/address" xmlns:p="http://example.com/person" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://example.com/person">
  <xs:import namespace="http://example.com/address" schemaLocation="address.xsd"/>
  <xs:element name="person">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name" type="xs:string"/>
        <xs:element ref="a:address"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>

